spring.application.name=GATEWAY
server.port=8083

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# QUIZ SERVICE ROUTE
spring.cloud.gateway.routes[0].id=QUIZ-SERVER
spring.cloud.gateway.routes[0].uri=lb://QUIZ-SERVER
spring.cloud.gateway.routes[0].predicates[0]=Path=/quiz/**

# QUESTIONS SERVICE ROUTE
spring.cloud.gateway.routes[1].id=QUESTIONS-SERVER
spring.cloud.gateway.routes[1].uri=lb://QUESTIONS-SERVER
spring.cloud.gateway.routes[1].predicates[0]=Path=/questions/**

# Auto-discovery locator
#spring.cloud.gateway.discovery.locator.enabled=true
#spring.cloud.gateway.discovery.locator.lower-case-service-id=true